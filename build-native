#!/usr/bin/env bash
# Builds the uberjar, then a native binary at ./mimiron.
set -euo pipefail
cd "$(dirname "$0")"
for tool in clojure native-image; do
    command -v "$tool" >/dev/null || { echo "missing: $tool" >&2; exit 1; }
done
clojure -T:build uber
native-image -jar target/mimiron.jar -o mimiron \
    --no-fallback --initialize-at-build-time -H:+ReportExceptionStackTraces
