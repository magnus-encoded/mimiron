BINDINGMODE 0
bind ESCAPE TOGGLEGAMEMENU
bind W MOVEFORWARD
bind ENTER OPENCHAT
bind / OPENCHATSLASH
bind SHIFT-1 ACTIONBUTTON1
bind C TOGGLECHARACTER0
bind F7 TOGGLEQUESTLOG
bind L NONE
bind CTRL-F SPELL Fireball
bind ALT-G MACRO Raid pull timer
bind ALT-H ITEM Hearthstone
bind ALT-I CLICK MultiBarBottomLeftButton1:LeftButton
bind PAD1 TOGGLETALENTS
bind ALT-N TOGGLETALENTS
