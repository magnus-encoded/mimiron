#!/usr/bin/env python3
"""Speech latency from the tehuti session log (current tehuti run by default).

Per session: recording seconds (start -> stop), wait seconds (stop -> transcript
received). Transcript text is message content: shown only with --text.
"""
import argparse, os, re, statistics, sys
from datetime import datetime, timezone

ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
LINE = re.compile(r"^(\S+Z)\s+\w+\s+\S+\s+speech (session started|session stopped|transcript received)\b.*?\bsession=(\d+)\b(.*)$")
TEXT = re.compile(r'text="(.*)"\s*$')


def ts(s):
    s = s.replace("Z", "+00:00")
    s = re.sub(r"\.(\d{6})\d*", r".\1", s)
    d = datetime.fromisoformat(s)
    return d if d.tzinfo else d.replace(tzinfo=timezone.utc)


def pct(xs, p):
    xs = sorted(xs)
    return xs[min(len(xs) - 1, int(round(p * (len(xs) - 1))))]


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--log", default=os.path.expanduser("~/.local/state/tehuti/session.log"))
    ap.add_argument("--since", help="ISO time; ignore events before it")
    ap.add_argument("--all-runs", action="store_true", help="do not cut at the last 'session started session=1'")
    ap.add_argument("--text", action="store_true", help="print first 50 chars of each transcript (message content)")
    a = ap.parse_args()
    since = ts(a.since) if a.since else None

    events = []
    with open(a.log, errors="replace") as f:
        for raw in f:
            m = LINE.match(ANSI.sub("", raw).rstrip("\n"))
            if m:
                events.append((ts(m[1]), m[2], int(m[3]), m[4]))
    if not a.all_runs:
        last = max((i for i, e in enumerate(events) if e[1] == "session started" and e[2] == 1), default=0)
        events = events[last:]
    if since:
        events = [e for e in events if e[0] >= since]

    rows, cur = [], {}
    for t, kind, n, rest in events:
        if kind == "session started":
            cur[n] = {"start": t}  # a new run restarts numbering and overwrites
        elif n in cur:
            d = cur[n]
            if kind == "session stopped":
                d["stop"] = t
            else:
                if "stop" in d:
                    text = TEXT.search(rest)
                    rows.append((n, (d["stop"] - d["start"]).total_seconds(),
                                 (t - d["stop"]).total_seconds(), text[1] if text else ""))
                del cur[n]

    print(f"{'session':>7} {'rec_s':>7} {'wait_s':>7}" + ("  text" if a.text else ""))
    for n, rec, wait, text in rows:
        print(f"{n:>7} {rec:7.2f} {wait:7.2f}" + (f"  {text[:50]}" if a.text else ""))
    waits = [r[2] for r in rows]
    if not waits:
        print("no completed sessions")
        return 1
    print(f"count={len(waits)} median={statistics.median(waits):.2f}s p90={pct(waits, 0.9):.2f}s over_5s={sum(w > 5 for w in waits)}")


if __name__ == "__main__":
    sys.exit(main())
